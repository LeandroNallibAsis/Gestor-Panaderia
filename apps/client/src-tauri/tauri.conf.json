{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Panadería Control",
  "version": "0.1.0",
  "identifier": "com.panaderiacontrol.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Panadería Control",
        "width": 430,
        "height": 880,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
